# ============================================================
# GestorFlex — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus dados
# ============================================================

# Servidor
PORT=3001
NODE_ENV=development

# ── Banco de dados ──────────────────────────────────────────
# Driver: 'tedious' (JS puro — Linux/macOS/Docker) ou
#         'msnodesqlv8' (ODBC — Windows/SQL Express).
# Deixe em branco para escolher automaticamente pelo SO.
DB_DRIVER=tedious

# Linux/Docker (SQL Server do docker-compose):
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=GestorFlex
DB_USER=sa
DB_PASSWORD=GestorFlex!2026
DB_ENCRYPT=false
DB_TRUST_CERT=true
# Instância nomeada (normalmente só no Windows, ex.: SQLEXPRESS). Vazio no Docker.
DB_INSTANCE=

# Windows com SQL Server Express — em vez do acima, use:
#   DB_DRIVER=msnodesqlv8
#   DB_SERVER=.\SQLEXPRESS

# JWT
JWT_SECRET=troque_por_uma_chave_secreta_longa_e_aleatoria
JWT_EXPIRES_IN=8h

# CORS — domínio do frontend (em prod, coloque o domínio real)
CORS_ORIGIN=http://localhost:5500
